# Site origin ONLY (no path). Used for canonical URLs, sitemap, hreflang and OG images.
# The base path below is appended by the modules automatically.
NUXT_PUBLIC_SITE_URL=https://user.github.io

# Base path the site is served from. `/` for a custom domain or user site, `/<repo>/` for a GitHub project page.
NUXT_APP_BASE_URL=/

# Set by the deploy workflow only (keeps local/other-host builds generic).
# NITRO_PRESET=github_pages
